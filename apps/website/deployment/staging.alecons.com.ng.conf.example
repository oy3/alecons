server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name staging.alecons.com.ng;

    root /home/rootlab/apps/alecons/staging/website/current;
    index index.html;

    auth_basic "ALECONS Website Staging";
    auth_basic_user_file /etc/nginx/.htpasswd-alecons-staging;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location = / {
        try_files /index.html =404;
    }

    location ^~ /verify/v1/ {
        try_files /verify.html =404;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /robots.txt {
        try_files $uri =404;
    }

    location = /sitemap.xml {
        try_files $uri =404;
    }

    location / {
        try_files $uri.html $uri =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    ssl_certificate /etc/letsencrypt/live/staging.alecons.com.ng/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.alecons.com.ng/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name staging.alecons.com.ng;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
