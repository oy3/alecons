NODE_ENV=production
PORT=8000
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/alecons_production
JWT_SECRET=replace_with_a_generated_secret
JWT_EXPIRATION=24h
SESSION_SECRET=replace_with_a_generated_secret
WEBSITE_URL=https://alecons.edu.ng
APPLICATION_PORTAL_URL=https://apply.alecons.edu.ng
STUDENT_PORTAL_URL=https://portal.alecons.edu.ng
STAFF_PORTAL_URL=https://staff.alecons.edu.ng
CBT_PORTAL_URL=https://cbt.alecons.edu.ng
PAYSTACK_SECRET_KEY=replace_with_live_secret_key
PAYSTACK_PUBLIC_KEY=replace_with_live_public_key
PAYSTACK_WEBHOOK_SECRET=replace_with_webhook_secret
SPACES_KEY=replace_with_spaces_key
SPACES_SECRET=replace_with_spaces_secret
SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
SPACES_REGION=lon1
SPACES_BUCKET_NAME=alecons
SPACES_CDN_URL=https://alecons.lon1.cdn.digitaloceanspaces.com
SPACES_ORIGIN_URL=https://alecons.lon1.digitaloceanspaces.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace_with_production_email
SMTP_PASS=replace_with_production_password
EMAIL_FROM=replace_with_production_email
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password
COOKIE_SECURE=true
COOKIE_DOMAIN=.alecons.edu.ng
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
