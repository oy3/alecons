# DigitalOcean Spaces Configuration
# These variables need to be set in your .env file

# DigitalOcean Spaces Credentials
SPACES_KEY=your_spaces_access_key_here
SPACES_SECRET=your_spaces_secret_key_here

# DigitalOcean Spaces Settings
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com  # Replace 'nyc3' with your region
SPACES_REGION=us-east-1  # AWS S3 compatible region
SPACES_BUCKET_NAME=your-bucket-name-here

# Optional: CDN URL if you have one set up
SPACES_CDN_URL=https://your-bucket-name.nyc3.cdn.digitaloceanspaces.com

# Instructions:
# 1. Create a DigitalOcean Spaces bucket in your account
# 2. Generate API keys in DigitalOcean Control Panel > API > Spaces Keys
# 3. Replace the values above with your actual credentials
# 4. Update the endpoint to match your chosen region
# 5. Copy these variables to your main .env file