# Environment Configuration
NODE_ENV=development

# API Configuration
API_PORT=8000
API_HOST=localhost

# Frontend Ports
CBT_PORT=3004
APPLICATION_PORT=3000
STAFF_PORT=3001
STUDENT_PORT=3002

# Database
MONGODB_URI=mongodb://localhost:27017/alecons
MONGODB_TEST_URI=mongodb://localhost:27017/alecons_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# File Storage (for production)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Email Configuration (for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-app-password

# Production URLs
API_BASE_URL=https://api.yourdomain.com
CBT_URL=https://cbt.yourdomain.com
APPLICATION_URL=https://apply.yourdomain.com
STAFF_URL=https://staff.yourdomain.com
STUDENT_URL=https://student.yourdomain.com