    "start": "nest start",
    "start:dev": "rm -f tsconfig.build.tsbuildinfo && NODE_ENV=development NODE_NO_WARNINGS=1 nest start --watch",
    "start:dev:safe": "rm -f tsconfig.build.tsbuildinfo && tsc-watch --onSuccess \"node dist/main.js\"",
    "start:dev:verbose": "rm -f tsconfig.build.tsbuildinfo && NODE_ENV=development nest start --watch",
    "start:debug": "rm -f tsconfig.build.tsbuildinfo && NODE_ENV=development nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "echo \"No tests yet\"",
    "clean": "rm -rf node_modules yarn.lock package-lock.json dist* tsconfig.build.tsbuildinfo",
    "seed:staff": "ts-node -r tsconfig-paths/register src/scripts/seed-staff.ts"
  },
